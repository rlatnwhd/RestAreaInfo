{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "server/data/**"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index?__api_path=:path*" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
